{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "indodax-quant",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // React dashboard served by Workers Static Assets; /api/* is handled by the Worker first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Cron Trigger (UTC): run the pipeline every minute.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": { "enabled": true },
  // Notifications leave the cron invocation through a queue, so Telegram delivery no longer competes
  // for the run's subrequest budget (Workers Free: 50 per invocation). The producer binding is
  // optional in code: without it `enqueueNotifications` sends inline, so a queue outage degrades to
  // the previous behaviour instead of losing the page.
  "queues": {
    "producers": [
      { "binding": "NOTIFY_QUEUE", "queue": "indodax-quant-notifications" }
    ],
    "consumers": [
      {
        "queue": "indodax-quant-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "max_concurrency": 1
      }
    ]
  },
  // Out-of-band watchdog: its alarm keeps running even when the cron trigger stops invoking the
  // Worker, which the in-run outage alarm cannot do. SQLite-backed because Workers Free only allows
  // that storage backend.
  "durable_objects": {
    "bindings": [
      { "name": "WATCHDOG", "class_name": "PipelineWatchdog" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PipelineWatchdog"] }
  ],
  // Workers Builds runs `wrangler preview` on pull_request events (deploy on main is `wrangler deploy`).
  // `preview` is an open beta that hard-fails without this block, so PR builds went red while main
  // builds passed. Values mirror the generated defaults; previews stay non-observed on purpose.
  "previews": {
    "observability": {
      "enabled": false,
      "head_sampling_rate": 1,
      "issues": { "enabled": false },
      "logs": { "enabled": false, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
      "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true }
    }
  },
  // Public values only. Secrets are set with `wrangler secret put` (see README):
  //   SUPABASE_SERVICE_ROLE_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, POSTHOG_PROJECT_TOKEN
  "vars": {
    "SUPABASE_URL": "https://znikuooxiqfcicyuhqsx.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_GTvV2X7uTGOjKZXZCy1cnA_Rv9Y3HVj",
    // indodax.com returns 403 to Cloudflare Workers; market data goes through this read-only relay.
    "INDODAX_PROXY_URL": "https://znikuooxiqfcicyuhqsx.supabase.co/functions/v1/indodax-proxy",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "ENVIRONMENT": "production",
    // Workers Free allows 50 subrequests per invocation. The pipeline budgets optional work
    // (trade fetches, history backfill) against this so store_market/analyze/finish_run always run.
    // Raise this when the account moves to a paid plan (paid default is 10,000).
    "SUBREQUEST_LIMIT": "50"
  }
}
