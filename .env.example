# INDODAX QUANT — configuration reference
# ---------------------------------------------------------------------------
# Public values (already in wrangler.jsonc "vars"; safe to expose to the browser)
SUPABASE_URL=https://znikuooxiqfcicyuhqsx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Cloudflare Worker SECRETS — never commit real values.
# Production:  npx wrangler secret put <NAME>   (or GitHub Actions secrets, see README)
# Local dev:   copy to .dev.vars (git-ignored) for `wrangler dev`

# Supabase service role / secret key (Project Settings → API Keys). Backend only!
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot API (create a bot with @BotFather, then get your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# GitHub Actions repository secrets used by .github/workflows/deploy.yml
# CLOUDFLARE_API_TOKEN=   # token with "Edit Cloudflare Workers" permissions
# CLOUDFLARE_ACCOUNT_ID=
# SUPABASE_SERVICE_ROLE_KEY=, TELEGRAM_BOT_TOKEN=, TELEGRAM_CHAT_ID=  (synced to Worker secrets on deploy)

# NOTE: INDODAX market data uses only the official PUBLIC API — no INDODAX API key exists
# in this project and none must ever be added. Live trading is not supported.
